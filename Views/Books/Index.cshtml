@model IEnumerable<bookstore.Models.Book>

@{
    ViewData["Title"] = "Book Store";
}

<div class="container-fluid p-0">

    <!-- HERO -->
    <div class="bg-dark text-white py-5 mb-5">
        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <h1 class="display-4 fw-bold">
                        Welcome to BookStore
                    </h1>

                    <p class="lead text-light">
                        Discover bestselling novels, manga, educational books,
                        comics and more.
                    </p>

                    <a href="#books" class="btn btn-primary btn-lg">
                        Browse Books
                    </a>

                </div>

                <div class="col-lg-5 text-center">

                    <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f"
                         class="img-fluid rounded shadow"
                         style="max-height:300px;object-fit:cover;">

                </div>

            </div>

        </div>
    </div>

    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 id="books">
                Latest Books
            </h2>

            <input type="text"
                   class="form-control w-25"
                   placeholder="Search (Coming Soon)">
        </div>

        <div class="row">
            <div class="mb-4">

                <a asp-action="Index" class="btn btn-dark me-2 mb-2">
                    All
                </a>

                @foreach (var category in ViewBag.Categories)
                {
                    <a asp-action="Index"
                       asp-route-category="@category.CategoryId"
                       class="btn btn-outline-primary me-2 mb-2">

                        @category.CategoryName

                    </a>
                }

            </div>

            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                    <div class="card border-0 shadow h-100 book-card">

                        <img src="@item.CoverImage"
                             class="card-img-top"
                             style="height:330px;object-fit:cover;">

                        <div class="card-body d-flex flex-column">

                            <span class="badge bg-primary mb-2">
                                @item.Category?.CategoryName
                            </span>

                            <h5 class="fw-bold">
                                @item.Title
                            </h5>

                            <small class="text-muted mb-2">
                                @item.Author
                            </small>

                            <p class="text-success fw-bold fs-5">
                                $@item.Price
                            </p>

                            @if (item.Stocks > 5)
                            {
                                <span class="badge bg-success mb-3">
                                    In Stock
                                </span>
                            }
                            else if (item.Stocks > 0)
                            {
                                <span class="badge bg-warning text-dark mb-3">
                                    Low Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger mb-3">
                                    Out of Stock
                                </span>
                            }

                            <a asp-action="Details"
                               asp-route-id="@item.BookId"
                               class="btn btn-dark mt-auto">

                                View Details

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

<style>

    .book-card {
        transition: .3s;
    }

        .book-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0,0,0,.25) !important;
        }

    .card-title {
        min-height: 55px;
    }

</style>